# =====================================================================
# KredoBook - Backend Production & Development Environment
# =====================================================================

# Database Configuration (Neon PostgreSQL)
# Direct or connection pooled URL with SSL enabled
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication & Security
# Generate a high-entropy secret using: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Origins (Comma-separated list of allowed frontend domains, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app

# Email Service Configuration (Official KredoBook Mailer)
# Set true only after all SMTP credentials below are configured.
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
# Preferred for Render/Gmail. The service also supports 587 with STARTTLS.
EMAIL_PORT=465
EMAIL_USERNAME=kredobook@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=kredobook@gmail.com
EMAIL_FROM_NAME=KredoBook
FRONTEND_URL=https://kredobook.vercel.app

# File Upload & Storage Limits
# Max size in bytes (e.g. 5242880 = 5MB)
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/screenshots

# Initial Superadmin Auto-seed (optional, runs on first launch if empty)
INITIAL_ADMIN_EMAIL=admin@loantracker.com
INITIAL_ADMIN_PASSWORD=AdminPass123!
