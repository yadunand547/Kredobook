# Backend configuration. Save local values in .env.local at the repository root
# or backend/.env; deployment platforms should use their environment dashboard.

# Database configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: use the direct, non-pooler URL for Alembic migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your-secret-key-at-least-32-bytes-long-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kredobook.vercel.app
FRONTEND_URL=https://kredobook.vercel.app

# Email (Brevo HTTPS API; works on Render Free)
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=kredobook@gmail.com
EMAIL_FROM_NAME=KredoBook

# Uploads
UPLOAD_MAX_SIZE=5242880
