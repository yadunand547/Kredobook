# Database configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your-secret-key-at-least-32-bytes-long-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
